# ---------------------------------------------------------------------------
# fordona-boost-cms-bridge — environment configuration
# Copy to .env for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# local | dev | staging | prod. AUTH_ENABLED=false is refused outside "local".
APP_ENV=local
LOG_LEVEL=INFO
# json | console. Defaults to console when APP_ENV=local, json otherwise.
LOG_FORMAT=console
# Serve /docs, /redoc and /openapi.json.
DOCS_ENABLED=true
# Comma-separated list of browser origins allowed by CORS. Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Boost CMS (upstream) --------------------------------------------------
BOOST_BASE_URL=https://boost.fordona.io
# Base URL the frontend uses to load public assets (/assets/{assetId}).
# Defaults to BOOST_BASE_URL when unset.
BOOST_PUBLIC_BASE_URL=https://boost.fordona.io
# Trusted delivery service credential. Server-side only — never ship to a client.
BOOST_DELIVERY_TOKEN=change-me
BOOST_CONNECT_TIMEOUT=2.0
BOOST_READ_TIMEOUT=5.0
BOOST_MAX_RETRIES=2
# Upper bound on one upstream call including retries and backoff (seconds).
BOOST_TOTAL_BUDGET=8.0

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/boost_bridge
REDIS_URL=redis://localhost:6379/0

# --- Cache (seconds) -------------------------------------------------------
# Served without contacting Boost while younger than SOFT; served-and-refreshed
# between SOFT and HARD; evicted from Redis after HARD.
CACHE_SOFT_TTL_SECONDS=300
CACHE_HARD_TTL_SECONDS=86400
# How long a Boost 404 is remembered.
CACHE_NEGATIVE_TTL_SECONDS=30

# --- Auth (Kinde) ----------------------------------------------------------
AUTH_ENABLED=true
KINDE_ISSUER_URI=https://your-tenant.kinde.com
KINDE_JWKS_URI=https://your-tenant.kinde.com/.well-known/jwks
# Comma-separated; a token is accepted if its aud contains any of these.
KINDE_AUDIENCE=https://api.fordona.io

# --- Locale ----------------------------------------------------------------
DEFAULT_LOCALE=sv-SE
