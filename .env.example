# ---------------------------------------------------------------------------
# fordona-boost-cms-bridge — environment configuration
# Copy to .env for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# local | dev | staging | prod. AUTH_ENABLED=false is refused outside "local".
APP_ENV=local
LOG_LEVEL=INFO
# json | console. Defaults to console when APP_ENV=local, json otherwise.
LOG_FORMAT=console
# Serve /docs, /redoc and /openapi.json.
DOCS_ENABLED=true
# Comma-separated list of browser origins allowed by CORS. Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Boost CMS (upstream) --------------------------------------------------
# The API origin (the CMS UI lives at boost.fordona.io).
BOOST_BASE_URL=https://boost-api.fordona.io
# Which credential to present to Boost's delivery API:
#   service_token          Boost's shared delivery service token (BOOST_DELIVERY_TOKEN).
#                          Recommended: learners never hold a token Boost accepts, so the
#                          bridge is the only way to reach theory content.
#   forward_learner_token  forward the caller's verified Kinde token (needs a
#                          Boost-audience token in KINDE_AUDIENCE). Legacy: such a token
#                          also works against Boost directly, bypassing the bridge, and
#                          startup logs access_boundary_not_enforced.
BOOST_AUTH_MODE=service_token
# Only for BOOST_AUTH_MODE=service_token. Server-side only; never ship to a client.
# Note: Boost's bst_ API tokens cannot call delivery routes and will not work here.
BOOST_DELIVERY_TOKEN=
# Fallback asset URL prefix ({prefix}/{assetId}). Each delivery item normally carries
# its own assetBaseUrl, which takes precedence. Defaults to {BOOST_BASE_URL}/assets.
# BOOST_ASSET_BASE_URL=https://boost-api.fordona.io/assets
BOOST_CONNECT_TIMEOUT=2.0
# Plan §7.4/§9.1: "1.5 s per Boost call" — bounds p99 on a cold cache entry.
BOOST_READ_TIMEOUT=1.5
BOOST_MAX_RETRIES=1
# Upper bound on one upstream call including retries and backoff (seconds).
BOOST_TOTAL_BUDGET=3.0

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/boost_bridge
REDIS_URL=redis://localhost:6379/0

# --- Cache (seconds) -------------------------------------------------------
# Served without contacting Boost while younger than SOFT; served-and-refreshed
# between SOFT and HARD; evicted from Redis after HARD.
CACHE_SOFT_TTL_SECONDS=300
CACHE_HARD_TTL_SECONDS=86400
# How long a Boost 404 is remembered.
CACHE_NEGATIVE_TTL_SECONDS=30

# --- Auth (Kinde) ----------------------------------------------------------
AUTH_ENABLED=true
KINDE_ISSUER_URI=https://fordona.kinde.com
KINDE_JWKS_URI=https://fordona.kinde.com/.well-known/jwks
# Comma-separated; a token is accepted if its aud contains any of these. Matching
# is exact, trailing slash included. Use the Fordona API audience — the same value as
# fordona-engine's KINDE_AUDIENCE — so the theory app needs one token for both
# services. Do not add Boost's audience (https://boost-api.fordona.io/): a token
# accepted here would then also be accepted by Boost directly.
KINDE_AUDIENCE=https://api.fordona.io

# --- Locale ----------------------------------------------------------------
DEFAULT_LOCALE=sv-SE

# --- Engine (fordona-engine, internal API) ----------------------------------
ENGINE_BASE_URL=http://engine.internal:8080
# Required outside APP_ENV=local — sent as X-Fordona-Internal-Token on every
# /internal/theory/** call; must match the engine's own THEORY_INTERNAL_TOKEN.
ENGINE_INTERNAL_TOKEN=
ENGINE_READ_TIMEOUT=2.0
# Phase completion does more work engine-side (progress writes), so it gets a
# longer budget than an ordinary read.
ENGINE_PHASE_COMPLETE_TIMEOUT=5.0
ENGINE_POOL_MAX_CONNECTIONS=20

# --- Boost batching / prefetch -----------------------------------------------
# Max question refs per Boost batch-grading/body call.
BOOST_BATCH_MAX_REFS=100
# Warm the cache for every current question/lesson revision after an engine
# release change. Off by default — a background task, rate-limited.
CONTENT_PREFETCH_ON_RELEASE=false
# Pause (seconds) between prefetch batch calls to Boost.
CONTENT_PREFETCH_BATCH_DELAY_SECONDS=0.2

# --- Media (signed CDN URLs) -------------------------------------------------
MEDIA_CDN_BASE_URL=https://media.fordona.io
# Server-side only; never ship to a client. Required outside APP_ENV=local.
MEDIA_SIGNING_KEY=
# Plan §9.5: "TTL 2 h covers a long lesson."
MEDIA_SIGNED_URL_TTL_SECONDS=7200
# Comma-separated unit ids (decimal-string ContentIds) whose media is never
# signed — the free unit's content needs no entitlement check to view.
MEDIA_FREE_UNIT_IDS=

# --- Rate limiting (per learner, per minute) --------------------------------
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30
